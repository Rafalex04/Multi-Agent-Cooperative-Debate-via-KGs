{
  "categories": [
    {
      "category": "echo_pattern_descriptor",
      "display": "echo pattern descriptor",
      "meta_category": "mass_finding",
      "values": [
        {
          "value": "anechoic",
          "display": "anechoic",
          "definition": "Without internal echoes."
        },
        {
          "value": "heterogeneous_echo_pattern",
          "display": "heterogeneous echo pattern",
          "definition": "Displays a mix of echo patterns."
        },
        {
          "value": "hyperechoic",
          "display": "hyperechoic",
          "definition": "Having increased echogenicity relative to fat or equal to fibroglandular tissue."
        },
        {
          "value": "hypoechoic",
          "display": "hypoechoic",
          "definition": "Less echogenic than fat but not anechoic (darker gray than fat but not black)."
        },
        {
          "value": "isoechoic",
          "display": "isoechoic",
          "definition": "Same echogenicity as subcutaneous fat and may be relatively inconspicuous."
        },
        {
          "value": "mixed_solid_and_cystic",
          "display": "mixed solid and cystic",
          "definition": "Contains both solid (iso-, hypo-, or hyperechoic) and cystic or fluid (anechoic) components. The important feature is the solid component."
        }
      ]
    },
    {
      "category": "margin_descriptor",
      "display": "margin descriptor",
      "meta_category": "mass_finding",
      "values": [
        {
          "value": "circumscribed",
          "display": "circumscribed",
          "definition": "Well-defined, with a sharp transition between the mass and the surrounding tissue. For a mass to be described as circumscribed at ultrasound, the entire margin must be sharply defined."
        },
        {
          "value": "non_circumscribed",
          "display": "non circumscribed",
          "definition": "Any portion of the margin is non-circumscribed."
        }
      ]
    },
    {
      "category": "orientation_descriptor",
      "display": "orientation descriptor",
      "meta_category": "mass_finding",
      "values": [
        {
          "value": "non_parallel",
          "display": "non parallel",
          "definition": "The anteroposterior dimension of the mass is equal to or greater than the horizontal dimension in any ultrasound orientation."
        },
        {
          "value": "parallel",
          "display": "parallel",
          "definition": "The horizontal dimension of the mass is greater than the anteroposterior dimension in all US orientations."
        }
      ]
    },
    {
      "category": "posterior_feature_descriptor",
      "display": "posterior feature descriptor",
      "meta_category": "mass_finding",
      "values": [
        {
          "value": "no_posterior_features",
          "display": "no posterior features",
          "definition": "No shadowing or enhancement deep to the mass."
        },
        {
          "value": "posterior_enhancement",
          "display": "posterior enhancement",
          "definition": "An echogenic column deep to the mass is brighter than that seen in the adjacent tissue at a similar depth."
        },
        {
          "value": "posterior_shadowing",
          "display": "posterior shadowing",
          "definition": "The area posterior to the mass (shadowing column) is darker than the tissue at the same depth to either side of the mass; edge shadows should be disregarded."
        }
      ]
    },
    {
      "category": "shape_descriptor",
      "display": "shape descriptor",
      "meta_category": "mass_finding",
      "values": [
        {
          "value": "irregular",
          "display": "irregular",
          "definition": "Neither oval, lobulated, nor round with acute angle protrusions."
        },
        {
          "value": "lobulated",
          "display": "lobulated",
          "definition": "Generally oval shape but exhibits one or more indentations resulting in an undulating contour."
        },
        {
          "value": "oval",
          "display": "oval",
          "definition": "Elliptical or egg-shaped mass."
        },
        {
          "value": "round",
          "display": "round",
          "definition": "Spherical or ball-shaped mass."
        }
      ]
    },
    {
      "category": "tissue_pattern",
      "display": "tissue pattern",
      "meta_category": "breast_tissue_composition",
      "values": [
        {
          "value": "heterogeneous_background_echotexture",
          "display": "heterogeneous background echotexture",
          "definition": "The breast echotexture is characterized by multiple small areas of relative increased and decreased echogenicity."
        },
        {
          "value": "homogeneous_background_echotexture_fat",
          "display": "homogeneous background echotexture fat",
          "definition": "Fat lobules and uniformly echogenic bands of supporting structures comprise the bulk of breast tissue."
        },
        {
          "value": "homogeneous_background_echotexture_fibroglandular",
          "display": "homogeneous background echotexture fibroglandular",
          "definition": "A thick zone of homogeneously echogenic fibroglandular parenchyma is present beneath the isoechoic layer of subcutaneous fat lobules."
        }
      ]
    }
