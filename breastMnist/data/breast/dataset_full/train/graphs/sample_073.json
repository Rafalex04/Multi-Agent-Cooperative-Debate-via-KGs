        "uuid": "3c0cfc5b-f4f9-450e-8830-886dbd98d8e6",
        "type": "claim",
        "text": "The heterogeneous echo pattern observed in the lesion supports a malignant interpretation, as it is not a typical feature of benign lesions.",
        "label": "MALIGNANT",
        "label_int": 1,
        "expert_id": "expert_b",
        "round_idx": 0
      },
      {
