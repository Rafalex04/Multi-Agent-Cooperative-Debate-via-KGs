        "uuid": "722aac73-618d-43bf-aa8f-de16214b0f86",
        "type": "claim",
        "text": "The lesion's heterogeneous echo pattern is a hallmark of malignancy, as it contrasts with the homogenous echo patterns typically seen in benign lesions",
        "label": "MALIGNANT",
        "label_int": 1,
