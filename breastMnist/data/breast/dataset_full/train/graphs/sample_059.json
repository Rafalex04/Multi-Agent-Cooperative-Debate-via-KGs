      },
      {
        "node_id": "c2",
        "uuid": "9e3aa9df-28e3-4232-a812-edb9895c9073",
        "type": "claim",
        "text": "The mass has a parallel orientation, which is a feature suggestive of a benign lesion.",
        "label": "BENIGN",
        "label_int": 0,
        "expert_id": "expert_a",
        "round_idx": 0
      },
      {
        "node_id": "c3",
        "uuid": "52a8906a-450f-43b1-aa46-0d2019d43d82",
        "type": "claim",
        "text": "The mass has a circumscribed margin, which is a benign feature.",
        "label": "BENIGN",
        "label_int": 0,
