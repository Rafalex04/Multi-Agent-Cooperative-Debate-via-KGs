        "uuid": "ed3f130e-cd3f-4a39-a637-a7074fdada62",
        "type": "claim",
        "text": "The posterior shadowing is a typical feature of benign breast cysts, as seen in the ultrasound lexicon of simple breast cysts",
        "label": "BENIGN",
        "label_int": 0,
        "expert_id": "expert_a",
        "round_idx": 1
      },
      {
