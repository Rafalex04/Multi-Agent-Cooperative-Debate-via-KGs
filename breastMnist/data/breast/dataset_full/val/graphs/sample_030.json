        "type": "claim",
        "text": "The lesion shows a homogeneous echo pattern, which is consistent with benign masses.",
        "label": "BENIGN",
        "label_int": 0,
        "expert_id": "expert_a",
        "round_idx": 0
      },
      {
        "node_id": "c3",
