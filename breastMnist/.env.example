# Copy this file to .env and fill in values. Never commit .env.

# Ollama server (for dev/local)
OLLAMA_BASE_URL=http://localhost:11434

# vLLM server (for cluster)
VLLM_BASE_URL=http://localhost:8000

# BreastMNIST pipeline only — script to restart Ollama on the cluster after a
# connection/timeout failure. Optional; unset means no restart is attempted.
OLLAMA_RESTART_SCRIPT=
