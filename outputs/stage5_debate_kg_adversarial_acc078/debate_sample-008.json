      "id": "d0be532a-2df6-4c18-818e-e2a30a536a20",
      "short_id": "c45",
      "expert_id": "expert_a",
      "round_idx": 2,
      "text": "The location of the lesion in the subcutaneous plane is consistent with benign lipomas",
      "label": "BENIGN",
      "addressed": [
        {
          "node_id": "c47480d8-5be1-4dc2-bc5a-5c7dd8051c5e",
          "stance": "AGREE"
        }
      ],
      "provenance": [
