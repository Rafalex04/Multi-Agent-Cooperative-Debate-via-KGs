# Secrets — never commit
.env

# Hydra outputs
outputs/
multirun/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
.uv/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Model weights / large data — store on cluster, not in repo
*.bin
*.pt
*.pth
*.safetensors

# Experiment scratch
experiments/**/__pycache__/

# Pre-exported BreastMNIST images (30MB, regenerable from medmnist)
breastMnist/data/breast/images_224/

# Raw dataset archive: 128MB, over GitHub's 100MB hard limit.
# Re-downloadable from the BUS-BRA source; the derived .npz are tracked.
data/external/BUSBRA.zip

# RetinaMNIST images: 123MB across three npz, 82MB for train alone.
# Regenerable in one command: retinaMnist/src/retina_kg/prepare_retina.py
# The debate corpus alongside them is NOT ignored -- it cost fleet hours and
# is not reproducible bit-for-bit.
retinaMnist/data/retina/images_224/

# Dispatcher claim locks (empty files) and per-shard run logs.
retinaMnist/logs/claims/
retinaMnist/logs/*.log

# DermaMNIST images: 1,041MB across three npz (train alone is 728MB).
# Regenerable: dermaMnist/src/derma_kg/prepare_derma.py
# NOTE: these MUST live on NFS home, not /data -- /data is NODE-LOCAL and the
# compute nodes cannot see it, which dangles the symlink on every worker.
dermaMnist/data/derma/images_224/
dermaMnist/logs/*.log
dermaMnist/logs/claims/

# Cross-tree fan-out logs: per-shard stdout, not results.
# The results these produced are in shared/results/.
shared/logs/*.log
shared/logs/claims*/

# Live monitor scratch (regenerated by scripts/monitor_all.sh on every run).
experiments/monitor.log
